{
  "name": "sianter",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter='@sianter/*' --parallel dev",
    "dev:backend": "bun run --filter @sianter/backend dev",
    "dev:frontend": "bun run --filter @sianter/frontend dev",
    "build": "bun run --filter='@sianter/*' build",
    "typecheck": "bun run --filter='@sianter/*' typecheck",
    "db:generate": "bun run --filter @sianter/backend db:generate",
    "db:migrate": "bun run --filter @sianter/backend db:migrate",
    "db:push": "bun run --filter @sianter/backend db:push",
    "auth:generate": "bun run --filter @sianter/backend auth:generate"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.7.0"
  }
}
