{
  "name": "@sianter/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./permissions": {
      "types": "./src/auth/permissions.ts",
      "default": "./src/auth/permissions.ts"
    }
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/index.ts --target bun --outdir dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "bun run src/seed.ts",
    "auth:generate": "auth generate --config ./src/auth/auth.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.2.0",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/eden": "^1.4.9",
    "@paralleldrive/cuid2": "^3.3.0",
    "@sianter/shared": "workspace:*",
    "better-auth": "^1.6.23",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.29",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "@types/bun": "^1.3.14",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.0"
  }
}
